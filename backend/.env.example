# Copia a .env y ajusta. Nunca subas .env al repositorio (ver .gitignore).

ENVIRONMENT=development

# --- Base de datos ---
# Desarrollo local (sin dependencias):
DATABASE_URL=sqlite:///./giic.db
# Producción (PostgreSQL):
# DATABASE_URL=postgresql+psycopg://giic:giic@db:5432/giic

# --- Proveedor de datos ---
# sample = datos de EJEMPLO offline (arranque sin claves).
# eodhd  = real, cobertura global (recomendado). Requiere EODHD_API_KEY.
# fmp    = real, alternativo. Requiere FMP_API_KEY.
DATA_PROVIDER=sample
EODHD_API_KEY=
FMP_API_KEY=
DEFAULT_EXCHANGE=US

BASE_CURRENCY=USD
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Seguridad ---
# En producción define un secreto fuerte (openssl rand -hex 32). En dev puede quedar el default.
SECRET_KEY=dev-insecure-change-me
ACCESS_TOKEN_EXPIRE_SECONDS=3600
# Usuario admin inicial (se crea si la tabla de usuarios está vacía). Si ADMIN_PASSWORD
# queda vacío no se siembra ningún usuario (y en producción el arranque falla).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Límites del proveedor para el scanner ---
PROVIDER_RATE_PER_MIN=60
SCANNER_BATCH_SIZE=50
FUNDAMENTALS_MAX_AGE_DAYS=7
HISTORY_MAX_GAP_DAYS=4
