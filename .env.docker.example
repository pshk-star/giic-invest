# Copia a .env en la raíz (junto a docker-compose.yml) y rellena.
# docker compose lo lee automáticamente. NUNCA lo subas al repositorio.

# Contraseña de PostgreSQL (fuerte, generada). Ej: openssl rand -base64 24
POSTGRES_PASSWORD=

# Clave de firma de tokens (fuerte, única). Ej: openssl rand -hex 32
SECRET_KEY=

# Usuario admin inicial (se crea al primer arranque si no hay usuarios).
ADMIN_USERNAME=admin
# Contraseña fuerte: >=12 chars, mayúscula, minúscula, dígito y símbolo.
ADMIN_PASSWORD=

# Proveedor de datos: sample | eodhd | fmp
DATA_PROVIDER=sample
EODHD_API_KEY=
FMP_API_KEY=
PROVIDER_RATE_PER_MIN=60

# Orígenes CORS permitidos (frontend)
CORS_ORIGINS=http://localhost:8080
VITE_API_URL=http://localhost:8000
